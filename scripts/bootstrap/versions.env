# versions.env — single source of truth for pinned dependency versions.
# Sourced by every bootstrap script and by external/env.sh.
# Change a version HERE and re-run the corresponding bootstrap script.

# --- Toolchain (system-provided; recorded for provenance) ---
# Intel oneAPI Base+HPC kit is expected under /opt/intel/oneapi.
ONEAPI_ROOT="${ONEAPI_ROOT:-/opt/intel/oneapi}"
ONEAPI_VERSION="2026.1"          # compiler 2026.1.1 / MKL 2026.1 / MPI 2021.18 / TBB 2023.1
#
# ⚠ THE TOOLCHAIN IS SPLIT ACROSS TWO TREES, and `setvars.sh` only exposes one of them.
# compiler/2026.1 ships C/C++ ONLY (icx, icpx) — Intel moved Fortran into its own component,
# and the installed `ifx` (2025.3.3) lives in compiler/2025.3, which setvars does NOT put on
# PATH. common.sh therefore locates `ifx` itself; do not assume `FC` is on PATH after setvars.
#
# ⚠ MKL 2026.x BUMPED ITS SONAME .so.2 -> .so.3. Anything linked against MKL by an older
# toolchain does not load any more (found the hard way: 47 of 48 OpenMolcas binaries and every
# DIRAC binary). A oneAPI major update therefore invalidates every Fortran/MKL dependency
# below and they must be rebuilt — the Python stack and libcint/HDF5 were unaffected.

# --- Python interpreter (oneAPI intelpython; sudo-free, MKL-accelerated) ---
# The DEVELOPMENT interpreter is 3.12; the SYNTAX FLOOR stays at 3.9. Those are
# two different things and conflating them would break something real — external/venv_qc is
# Python 3.10 and kuiva must run there, so 3.11+ syntax in the library is a
# defect even though the dev venv would accept it. `requires-python = ">=3.9"` stands.
# NumPy is STILL 1.x on this interpreter (1.26.4), so every numpy<2 pin is unaffected.
# Validated on this stack: pyscf 2.14.0 installs and the scalar-X2C (sfx2c1e) path runs, and
# the default test suite passes.
#
# ⚠ PIN THE VERSIONED DIRECTORY, NEVER `intelpython/latest`. `latest` moved 3.9 -> 3.12 in the
# 2026.1 update and silently turned external/venv into a 3.12 interpreter pointed at a
# lib/python3.9/site-packages tree: `import pyscf` failed and every C extension in it was the
# wrong ABI. A venv's bin/python is a symlink *through* this path, so it is not a pin at all
# unless it names a version.
INTELPYTHON_ROOT="${INTELPYTHON_ROOT:-/opt/intel/oneapi/intelpython/python3.12}"
PYTHON_BIN="${INTELPYTHON_ROOT}/bin/python"   # 3.12.8 (Intel), numpy 1.26.4 (MKL), scipy 1.13.1

# --- Python packages (pip, into external/venv) ---
PYSCF_VERSION="2.14.0"           # pin PySCF and test against it

# --- Source-built dependencies (tarballs staged in external/src) ---
LIBCINT_VERSION="6.1.3"          # external/src/libcint-6.1.3.tar.gz
OPENMPI_VERSION="5.0.10"         # external/src/openmpi-5.0.10.tar.gz  (reference build; Intel MPI is default)
OPENMOLCAS_VERSION="v26.06"      # external/src/OpenMolcas-v26.06.tar.gz (Tier-2 reference generation only)
DIRAC_VERSION="26.1"             # external/src/DIRAC-26.1-Source.tar.gz (Tier-2 reference generation only)

# --- Source-built dependencies fetched from git (no upstream releases to pin against) ---
# x2camf: the reference implementation of X2CAMF by its authors (Liu & Cheng, JCP 148,
# 144108 (2018)); used for the term-by-term cross-check of kuiva/amf/ and as the
# optional, never-default correction method "x2camf-external". Import-gated everywhere; NOT a
# runtime dependency. The repository publishes no tags, so the pin is a commit SHA; its
# vendored pybind11 and Eigen submodules are pinned by that superproject commit.
X2CAMF_REPO="https://github.com/Warlocat/x2camf.git"
X2CAMF_COMMIT="42be969827a9bdd58ab0cc77b9abeb658c980edb"   # 2026-04-26

# --- Quantum-computing simulator stack (external/venv_qc; research-only) ---
# Testing/research only, NEVER a runtime dependency of kuiva: kuiva/qc/ is pure NumPy/SciPy
# and every framework import is gated (kuiva/qc/gate.py). Built by 90_qiskit.sh into a venv of
# its OWN, separate from external/venv, because Qiskit's dependency tree would otherwise drag
# the shared venv off the pinned NumPy-1.x / Python-3.9 baseline the rest of the project needs.
#
# ⚠ Its interpreter is NOT ${PYTHON_BIN}, and that is a pinned decision rather than an
# accident. Qiskit dropped Python 3.9 at 2.3.0 (2026-01), and qiskit-iqm — the documented
# route to VTT Q50 (Stage 6) — requires >=3.10,<3.13, so intelpython 3.9 would foreclose the
# hardware path outright. The pinned baseline is a statement about external/venv and the dev
# toolchain; kuiva is written to 3.9 *syntax* and runs unmodified on newer Pythons (verified:
# kuiva.ci/.rdm/.mcscf import and run under 3.10 + NumPy 2.x), and venv_qc is isolated
# precisely so its constraints never propagate back.
#
# ⚠ 90_qiskit.sh bootstraps pip with get-pip.py: Ubuntu's python3.10 ships without ensurepip
# (`python3-venv` is a sudo install), and the sandbox forbids sudo.
QC_PYTHON_BIN="${QC_PYTHON_BIN:-/usr/bin/python3.10}"   # 3.10.12 (system); >=3.10,<3.13
QISKIT_VERSION="2.5.1"           # circuits + quantum_info; latest at pin time (2026-07-23)
QISKIT_AER_VERSION="0.17.2"      # statevector AND shot-based/noisy simulation in one package
# qiskit-iqm is the IQM/VTT Q50 provider. NOT installed (optional dependencies are built only
# when actually needed); recorded so the Stage-6 pin is a decision, not a scramble.
QISKIT_IQM_VERSION="18.2"        # NOT INSTALLED — hardware access, deferred to Stage 6

# --- Native kernel backend (kuiva/_native<soabi>.so) ---
# pybind11 is a header-only build dependency of the OPTIONAL compiled kernel backend, built
# by 95_native.sh with icpx (C++20) against the already-loaded MKL (mkl_rt) and libiomp5.
# It is installed into external/venv with --no-deps (same trap as x2camf: an unpinned
# transitive numpy would pull 2.x and break the pinned-version baseline). A clone that never runs
# 95_native.sh runs everything pure-NumPy; KUIVA_KERNELS=native makes absence a hard error.
PYBIND11_VERSION="3.0.1"         # latest at pin time (2026-08-09); header-only, build-time only

# --- Source-built dependencies fetched from the network ---
HDF5_VERSION="1.14.3"            # required by OpenMolcas; system has runtime libs only, no dev headers
GA_VERSION="5.8.2"               # Global Arrays; required for MPI-parallel OpenMolcas (Intel MPI)
